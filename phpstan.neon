includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    excludePaths:
        # Published unchanged from laravel/pulse; its driver match is exhaustive only for the drivers Pulse supports.
        - database/migrations/2026_10_25_032753_create_pulse_tables.php
